{
  "version": 2,
  "policy": "Final-output ownership. Legacy passes may prepare distinct intermediate chapters but must not rewrite another family's final component.",
  "families": {
    "global-header-footer-logo": {
      "owner": "scripts/apply-foundation-v13.mjs",
      "stage": "foundation",
      "outputs": ["site/**/*.html"]
    },
    "typography-runtime-resources": {
      "owner": "scripts/apply-foundation-v13.mjs",
      "stage": "foundation",
      "outputs": ["site/styles.css", "site/home-v5.css", "site/foundation-mobile-hotfix.css"],
      "forbidden": ["fonts.googleapis.com", "fonts.gstatic.com"]
    },
    "home-proof-spine": {
      "owner": "scripts/apply-home-proof-spine-v10.mjs",
      "stage": "route-content",
      "outputs": ["site/index.html", "site/home-proof-spine.css", "site/home-proof-spine.js"]
    },
    "home-decision-room": {
      "owner": "scripts/apply-home-decision-room-v11-safe.mjs",
      "stage": "route-content",
      "outputs": ["site/index.html", "site/home-decision-room.css", "site/home-decision-room.js"]
    },
    "home-signature-reactor": {
      "owner": "scripts/apply-home-reactor-v14.mjs",
      "stage": "route-final",
      "outputs": ["site/index.html", "site/home-reactor.css", "site/home-reactor.js"],
      "superseded": ["scripts/apply-home-evidence-v9.mjs"],
      "notes": "Reactor now owns the Home hero/bridge directly. Proof Spine and Decision Room remain separate non-overlapping chapter owners. The superseded Evidence pass is not executed by the canonical build."
    },
    "search-surface": {
      "owner": "scripts/generate-search-surface.mjs",
      "stage": "search-final",
      "outputs": ["site/robots.txt", "site/sitemap.xml", "site/**/*.html metadata"]
    },
    "published-output": {
      "owner": "scripts/publish-site.mjs",
      "stage": "publish",
      "outputs": ["dist/**"]
    }
  },
  "buildOrder": [
    "generate assets/base pages",
    "legacy visual preparation passes",
    "route-specific service/contact/about/portfolio passes",
    "Home Proof Spine chapter",
    "Home Decision Room chapter",
    "foundation final globals/resources",
    "Home Reactor direct hero/bridge owner",
    "search surface finalization",
    "publish",
    "site + ownership + search QA"
  ]
}
